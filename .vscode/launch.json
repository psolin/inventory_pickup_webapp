{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django Runserver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "python": "${workspaceFolder}/venv/bin/python",
      "args": [
        "runserver",
        "0.0.0.0:8000"
      ],
      "django": true,
      "env": {
        "DEBUG": "True"
      },
      "preLaunchTask": "Kill Python Processes",
      "serverReadyAction": {
        "pattern": "Starting development server at https?://[^:]+:(\\d+)",
        "uriFormat": "http://127.0.0.1:%s/",
        "action": "openExternally"
      }
    }
  ]
}
